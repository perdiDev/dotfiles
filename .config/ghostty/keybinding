# reload config
keybind = ctrl+g>r=reload_config

# open command pallete
keybind = ctrl+g>o=toggle_command_palette

# toogle fullscreen
keybind = ctrl+g>f=toggle_fullscreen

# create new tab
keybind = ctrl+g>t=new_tab

# open new window
keybind = ctrl+g>w=new_window

# previous tab
keybind = ctrl+g>p=previous_tab

# next tab
keybind = ctrl+g>n=next_tab

# split tab
keybind = ctrl+g>shift+h=new_split:left
keybind = ctrl+g>shift+j=new_split:down
keybind = ctrl+g>shift+k=new_split:up
keybind = ctrl+g>shift+l=new_split:right

# change focus in split tab
keybind = ctrl+g>s>n=goto_split:next
keybind = ctrl+g>s>p=goto_split:previous
keybind = ctrl+g>h=goto_split:left
keybind = ctrl+g>j=goto_split:down
keybind = ctrl+g>k=goto_split:up
keybind = ctrl+g>l=goto_split:right

# resize split
keybind = ctrl+g>r>h=resize_split:left,100
keybind = ctrl+g>r>j=resize_split:down,100
keybind = ctrl+g>r>k=resize_split:up,100
keybind = ctrl+g>r>l=resize_split:right,100

# equalize split
keybind = ctrl+g>e=equalize_splits

# close split, tab, or window
keybind = ctrl+g>w>w=close_surface

# select all text
keybind = ctrl+g>a=select_all

# copy text
keybind = ctrl+g>y=copy_to_clipboard

# back to prompt
keybind = ctrl+g>i=jump_to_prompt:1

# write to open the terminal output
keybind = ctrl+g>b=write_scrollback_file:open


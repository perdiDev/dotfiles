@import "shared.rasi"

configuration {
    /* Opsional navigasi kiri/kanan khusus menu horizontal */
    kb-row-left: "h";
    kb-row-right: "l";
    kb-row-up: "Up,k";
    kb-row-down: "Down,j";
}

window {
    width: 800px;
}

mainbox {
    padding: 44px;
    spacing: 24px;
    children: [ "message", "listview" ];
}

message {
    padding: 0px 0px 8px 0px;
}

listview {
    columns: 3;
    lines: 2;
    spacing: 24px;
    fixed-columns: true;
    dynamic: false;
}

element {
    padding: 18px 12px;
    border-radius: 12px; /* Override radius dari shared.rasi */
}

element-text {
    horizontal-align: 0.5;
}

@import "shared.rasi"

window {
    width: 650px;
}

mainbox {
    padding: 32px;
    spacing: 20px;
    children: [ "message", "listview" ];
}

message {
    padding: 0px 0px 4px 0px;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 10px;
    fixed-columns: true;
    dynamic: true;
}

element {
    padding: 14px 18px;
}

element-text {
    horizontal-align: 0.0;
}
